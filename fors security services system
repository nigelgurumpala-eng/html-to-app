        // Edit attendance record
        function editAttendanceRecord(id) {
            const record = comprehensiveAttendance.find(r => r.id === id);
            if (record) {
                const newCheckIn = prompt(`Enter new check-in time for ${record.employeeName} (HH:MM):`, record.checkIn || '');
                if (newCheckIn !== null) {
                    record.checkIn = newCheckIn;
                }
                
                const newCheckOut = prompt(`Enter new check-out time for ${record.employeeName} (HH:MM):`, record.checkOut || '');
                if (newCheckOut !== null) {
                    record.checkOut = newCheckOut;
                }
                
                // Recalculate hours worked
                if (record.checkIn && record.checkOut) {
                    const checkInTime = new Date(`2000-01-01T${record.checkIn}`);
                    const checkOutTime = new Date(`2000-01-01T${record.checkOut}`);
                    
                    // Handle overnight shifts
                    if (checkOutTime < checkInTime) {
                        checkOutTime.setDate(checkOutTime.getDate() + 1);
                    }
                    
                    const diffMs = checkOutTime - checkInTime;
                    const diffHrs = diffMs / (1000 * 60 * 60);
                    record.hoursWorked = diffHrs.toFixed(2);
                }
                
                // Update status
                if (!record.checkIn && !record.checkOut) {
                    record.status = 'absent';
                } else if (record.checkIn && record.checkIn > record.scheduledStart) {
                    record.status = 'late';
                } else {
                    record.status = 'present';
                }
                
                renderAttendanceTable();
                alert('Attendance record updated successfully!');
            }
        }
        
