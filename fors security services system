<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FORS Security Services - Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #1e3a5f;
            --secondary: #2c5aa0;
            --accent: #e74c3c;
            --success: #2ecc71;
            --warning: #f39c12;
            --danger: #e74c3c;
            --light: #f5f7fa;
            --dark: #2c3e50;
            --text: #333;
            --text-light: #7f8c8d;
            --border: #ddd;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
            --radius: 10px;
        }

        .theme-dark {
            --primary: #0a1a2f;
            --secondary: #1e3a5f;
            --accent: #e94560;
            --success: #0f9d58;
            --warning: #f4b400;
            --danger: #db4437;
            --light: #1a2530;
            --dark: #121212;
            --text: #e2e8f0;
            --text-light: #a0aec0;
            --border: #2d3748;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        .theme-modern {
            --primary: #1e3a5f;
            --secondary: #2c5aa0;
            --accent: #f72585;
            --success: #4cc9f0;
            --warning: #f8961e;
            --danger: #e63946;
            --light: #f8f9fa;
            --dark: #212529;
            --text: #212529;
            --text-light: #6c757d;
            --border: #dee2e6;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--light);
            color: var(--text);
            transition: var(--transition);
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Login Styles */
        .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, var(--primary), #0a1a2f);
            padding: 20px;
        }

        .login-card {
            background: white;
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 40px;
            width: 100%;
            max-width: 450px;
            transition: var(--transition);
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            position: relative;
            overflow: hidden;
        }

        .login-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .login-header h1 {
            color: var(--primary);
            margin-bottom: 10px;
        }

        .login-header p {
            color: var(--text-light);
        }

        .user-type-selector {
            display: flex;
            background: var(--light);
            border-radius: 10px;
            padding: 5px;
            margin-bottom: 25px;
        }

        .user-type-btn {
            flex: 1;
            text-align: center;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 500;
        }

        .user-type-btn.active {
            background: white;
            box-shadow: var(--shadow);
            color: var(--primary);
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--text);
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 15px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 16px;
            transition: var(--transition);
        }

        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: var(--secondary);
            box-shadow: 0 0 0 3px rgba(44, 90, 160, 0.2);
        }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 40px;
            background: none;
            border: none;
            color: var(--text-light);
            cursor: pointer;
        }

        .login-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 20px;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .biometric-login-options {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
        }

        .biometric-option {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 15px;
            border-radius: 8px;
            background: var(--light);
            cursor: pointer;
            transition: var(--transition);
            width: 120px;
        }

        .biometric-option:hover {
            background: var(--primary);
            color: white;
        }

        .biometric-option i {
            font-size: 1.5rem;
        }

        /* Header Styles */
        header {
            background: white;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .logo-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .logo-text h1 {
            font-size: 1.5rem;
            color: var(--primary);
        }

        .logo-text p {
            font-size: 0.9rem;
            color: var(--text-light);
        }

        .nav-scroller {
            display: flex;
            gap: 5px;
            overflow-x: auto;
            padding: 10px 0;
            scrollbar-width: none;
            max-width: 600px;
        }

        .nav-scroller::-webkit-scrollbar {
            display: none;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
            border: 1px solid transparent;
        }

        .nav-item:hover {
            background: rgba(30, 58, 95, 0.1);
            border-color: var(--border);
        }

        .nav-item.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            background: var(--light);
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-right: 12px;
            border-right: 1px solid var(--border);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            overflow: hidden;
        }

        .user-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-info div div:first-child {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .user-info div div:last-child {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .date-display {
            font-size: 0.9rem;
            color: var(--text-light);
            padding: 0 12px;
            border-right: 1px solid var(--border);
        }

        .theme-selector {
            position: relative;
            padding-right: 12px;
            border-right: 1px solid var(--border);
        }

        .theme-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 12px;
            background: transparent;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition);
        }

        .theme-options {
            position: absolute;
            top: 100%;
            right: 0;
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
            padding: 10px;
            width: 180px;
            display: none;
            z-index: 10;
            border: 1px solid var(--border);
        }

        .theme-selector:hover .theme-options {
            display: block;
        }

        .theme-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition);
        }

        .theme-option:hover {
            background: var(--light);
        }

        .theme-option i {
            color: var(--success);
            opacity: 0;
        }

        .theme-option.active i {
            opacity: 1;
        }

        .notification-btn, .admin-btn, .emergency-btn, .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: white;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
        }

        .notification-btn:hover, .admin-btn:hover, .emergency-btn:hover, .logout-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 600;
        }

        /* Quick Access Panel */
        .quick-access-panel {
            position: fixed;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            background: white;
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 90;
        }

        .quick-access-btn {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--light);
            cursor: pointer;
            transition: var(--transition);
        }

        .quick-access-btn:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-3px);
        }

        /* Dashboard Styles */
        .dashboard {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
            margin-top: 20px;
        }

        .sidebar {
            background: white;
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 20px;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .sidebar-section {
            margin-bottom: 30px;
        }

        .sidebar-section h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            color: var(--primary);
        }

        .filter-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .filter-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-option:hover {
            background: rgba(30, 58, 95, 0.1);
        }

        .filter-option.active {
            background: var(--primary);
            color: white;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .stat-card {
            background: var(--light);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 10px 0 5px;
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .roster-board {
            background: white;
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 20px;
        }

        .board-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .board-header h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
        }

        .add-assignment-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

        .add-assignment-btn:hover {
            background: var(--secondary);
            color: white;
            transform: translateY(-2px);
        }

        .assignments-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .assignment-card {
            background: white;
            border-radius: 10px;
            box-shadow: var(--shadow);
            overflow: hidden;
            transition: var(--transition);
            animation: fadeIn 0.5s ease;
        }

        .assignment-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: var(--light);
        }

        .location {
            font-weight: 600;
            color: var(--primary);
        }

        .shift-time {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .card-body {
            padding: 15px;
        }

        .guard-info {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .guard-photo {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--light);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .guard-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .guard-details h3 {
            margin-bottom: 5px;
        }

        .guard-details p {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .assignment-details {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .detail-item {
            display: flex;
            justify-content: space-between;
        }

        .detail-label {
            font-weight: 500;
        }

        .status {
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .status-active {
            background: rgba(46, 204, 113, 0.2);
            color: var(--success);
        }

        .status-pending {
            background: rgba(243, 156, 18, 0.2);
            color: var(--warning);
        }

        .status-off {
            background: rgba(231, 76, 60, 0.2);
            color: var(--danger);
        }

        /* Duty Status Panel */
        .duty-status-panel {
            background: white;
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 20px;
            margin-bottom: 20px;
        }

        .duty-status-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .duty-status-header h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
        }

        .status-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .status-card {
            background: var(--light);
            border-radius: 10px;
            padding: 20px;
        }

        .status-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .status-card-title {
            font-weight: 600;
        }

        .status-card-count {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .on-duty .status-card-count {
            color: var(--success);
        }

        .off-duty .status-card-count {
            color: var(--danger);
        }

        .upcoming .status-card-count {
            color: var(--warning);
        }

        .status-card-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .status-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            background: white;
            border-radius: 6px;
        }

        .status-item-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            overflow: hidden;
        }

        .status-item-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .status-item-details {
            flex: 1;
        }

        .status-item-name {
            font-weight: 500;
            font-size: 0.9rem;
        }

        .status-item-time {
            font-size: 0.7rem;
            color: var(--text-light);
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 600px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow);
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid var(--border);
        }

        .modal-header h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-light);
        }

        .modal-body {
            padding: 20px;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 20px;
            border-top: 1px solid var(--border);
        }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 500;
        }

        .btn-cancel {
            background: var(--light);
            border: 1px solid var(--border);
        }

        .btn-save {
            background: var(--primary);
            color: white;
            border: none;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        /* Biometric Dashboard */
        .biometric-dashboard {
            background: white;
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 20px;
            margin-top: 20px;
        }

        .biometric-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .biometric-header h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--primary);
        }

        .biometric-controls {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .biometric-control {
            background: var(--light);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .biometric-control:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-5px);
        }

        .biometric-control i {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .attendance-log {
            background: var(--light);
            border-radius: 10px;
            padding: 20px;
        }

        .attendance-log h3 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            color: var(--primary);
        }

        .attendance-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: white;
            border-radius: 8px;
            margin-bottom: 10px;
        }

        .attendance-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            overflow: hidden;
        }

        .attendance-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .attendance-details {
            flex: 1;
        }

        .attendance-name {
            font-weight: 500;
        }

        .attendance-time {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        .attendance-type {
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .check-in {
            background: rgba(46, 204, 113, 0.2);
            color: var(--success);
        }

        .check-out {
            background: rgba(231, 76, 60, 0.2);
            color: var(--danger);
        }

        /* Employee Dashboard */
        .employee-dashboard {
            background: white;
