        // Password strength checker
        function checkPasswordStrength(password) {
            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/\d/)) strength++;
            if (password.match(/[^a-zA-Z\d]/)) strength++;
            
            return strength;
        }
        
        // Update password strength indicator
        function updatePasswordStrength(password) {
            const strength = checkPasswordStrength(password);
            const strengthBar = document.getElementById('passwordStrengthBar');
            
            strengthBar.style.width = `${strength * 25}%`;
            
            // Remove all classes
            strengthBar.classList.remove('password-strength-weak', 'password-strength-medium', 'password-strength-strong');
            
            // Add appropriate class
            if (strength <= 1) {
                strengthBar.classList.add('password-strength-weak');
            } else if (strength <= 3) {
                strengthBar.classList.add('password-strength-medium');
            } else {
                strengthBar.classList.add('password-strength-strong');
            }
        }
        
        // Biometric login functions
        function setupBiometricLogin() {
            fingerprintLogin.addEventListener('click', function() {
                startBiometricScan('fingerprint');
            });
            
            faceLogin.addEventListener('click', function() {
                startBiometricScan('face');
            });
            
            cancelScanBtn.addEventListener('click', function() {
                biometricScanner.classList.remove('active');
            });
            
            retryScanBtn.addEventListener('click', function() {
                retryScanBtn.style.display = 'none';
                simulateBiometricScan();
            });
        }
        
        function startBiometricScan(type) {
            if (type === 'fingerprint') {
                scannerTitle.textContent = 'Fingerprint Authentication';
                scannerMessage.textContent = 'Please place your finger on the scanner';
                scannerIcon.className = 'fas fa-fingerprint';
            } else {
                scannerTitle.textContent = 'Face Recognition';
                scannerMessage.textContent = 'Please look at the camera';
                scannerIcon.className = 'fas fa-user-circle';
            }
            
            biometricScanner.classList.add('active');
            retryScanBtn.style.display = 'none';
            
            simulateBiometricScan();
        }
        
        function simulateBiometricScan() {
            // Simulate scanning process
            setTimeout(function() {
                // 80% chance of success
                if (Math.random() > 0.2) {
                    scannerMessage.textContent = 'Authentication successful!';
                    setTimeout(function() {
                        biometricScanner.classList.remove('active');
                        // Automatically login with the selected user type
                        const userType = document.querySelector('.user-type-btn.active').getAttribute('data-type');
                        login(users[userType].username, users[userType].password, userType);
                    }, 1000);
                } else {
                    scannerMessage.textContent = 'Authentication failed. Please try again.';
                    retryScanBtn.style.display = 'block';
                }
            }, 3000);
        }
        
        // Login function
        function login(username, password, userType) {
            if (users[userType] && users[userType].username === username && users[userType].password === password) {
                currentUser = users[userType];
                currentUserType = userType;
                
                // Update UI with user info
                userRoleDisplay.textContent = `${userType.charAt(0).toUpperCase() + userType.slice(1)} Dashboard`;
                userName.textContent = currentUser.name;
                userPosition.textContent = currentUser.position;
                
                // Set user avatar
                if (currentUser.profilePicture) {
                    userAvatarImg.src = currentUser.profilePicture;
                    userAvatarImg.style.display = 'block';
                } else {
                    userAvatar.textContent = currentUser.avatar;
                    userAvatarImg.style.display = 'none';
                }
                
                // Setup access control based on user type
                setupAccessControl(userType);
                
                // Update employee dashboard if needed
                if (userType === 'employee') {
                    employeeName.textContent = currentUser.name;
                    employeeId.textContent = `ID: ${currentUser.id}`;
                    employeePosition.textContent = currentUser.position;
                    
                    // Set employee avatar
                    if (currentUser.profilePicture) {
                        employeeAvatarImg.src = currentUser.profilePicture;
                        employeeAvatarImg.style.display = 'block';
                    } else {
                        employeeAvatar.innerHTML = `<i class="fas fa-user"></i>`;
                        employeeAvatarImg.style.display = 'none';
                    }
                    
                    renderEmployeeShifts();
                }
                
                // Switch to main application
                loginContainer.style.display = 'none';
                mainApplication.style.display = 'block';
                
                return true;
            }
            return false;
        }
        
