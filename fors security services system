                assignment.date >= today
            );
            
            if (!employeeShift) {
                alert('No upcoming shifts found to swap.');
                return;
            }
            
            let currentShiftText = '';
            switch(employeeShift.shift) {
                case 'morning': currentShiftText = 'Morning (06:00 - 14:00)'; break;
                case 'afternoon': currentShiftText = 'Afternoon (14:00 - 22:00)'; break;
                case 'night': currentShiftText = 'Night (22:00 - 06:00)'; break;
            }
            
            // Create shift swap request
            const newRequest = {
                id: shiftSwapRequests.length + 1,
                employeeName: currentUser.name,
                employeeId: currentUser.id,
                currentShift: currentShiftText,
                requestedShift: shiftText,
                date: date,
                reason: reason,
                status: 'pending'
            };
            
            shiftSwapRequests.push(newRequest);
            
            // Reset form
            shiftSwapForm.reset();
            
            // Set default swap date to tomorrow
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            swapDate.value = tomorrow.toISOString().split('T')[0];
            
            alert('Shift swap request submitted successfully! It will be reviewed by an administrator.');
        }
        
        // Event Listeners
        document.addEventListener('DOMContentLoaded', function() {
            // User type selection
            userTypeBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    userTypeBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                });
            });
            
            // Password toggle
            passwordToggle.addEventListener('click', function() {
                const passwordInput = document.getElementById('password');
                const icon = this.querySelector('i');
                
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    passwordInput.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
            
            // Login form submission
            loginForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const username = document.getElementById('username').value;
                const password = document.getElementById('password').value;
                const userType = document.querySelector('.user-type-btn.active').getAttribute('data-type');
                
                if (login(username, password, userType)) {
                    console.log('Login successful');
                } else {
                    alert('Invalid username or password. Please try again.');
                }
            });
            
            // Theme selection
            themeOptions.forEach(option => {
                option.addEventListener('click', function() {
                    const theme = this.getAttribute('data-theme');
                    document.body.className = `theme-${theme}`;
                    
                    // Update active theme option
                    themeOptions.forEach(opt => opt.classList.remove('active'));
                    this.classList.add('active');
                });
            });
            
            // Notification button
            notificationBtn.addEventListener('click', function() {
                document.getElementById('notificationsPanel').classList.toggle('show');
                renderNotifications();
            });
            
            // Logout button
            logoutBtn.addEventListener('click', function() {
                if (confirm('Are you sure you want to logout?')) {
                    loginContainer.style.display = 'flex';
                    mainApplication.style.display = 'none';
                    currentUser = null;
                    currentUserType = null;
                }
            });
            
            // Add assignment button
            addAssignmentBtn.addEventListener('click', addAssignment);
            
            // Close modal
            closeModalBtn.addEventListener('click', function() {
                assignmentModal.classList.remove('show');
            });
            
            cancelBtn.addEventListener('click', function() {
                assignmentModal.classList.remove('show');
            });
            
            // Save assignment
            saveBtn.addEventListener('click', saveAssignment);
            
            // Filter assignments
            filterOptions.forEach(option => {
                option.addEventListener('click', function() {
                    if (this.classList.contains('active')) return;
                    
                    filterOptions.forEach(opt => opt.classList.remove('active'));
                    this.classList.add('active');
                    
                    const filter = this.getAttribute('data-filter');
                    renderAssignments(filter);
                });
            });
            
            // Refresh status
            refreshStatusBtn.addEventListener('click', updateDutyStatus);
            
            // Mark all notifications as read
            markAllReadBtn.addEventListener('click', function() {
                notifications.forEach(notification => {
                    notification.unread = false;
                });
                updateNotificationBadge();
                renderNotifications();
            });
            
            // Clear all notifications
            clearAllNotificationsBtn.addEventListener('click', function() {
                if (confirm('Are you sure you want to clear all notifications?')) {
                    notifications = [];
                    updateNotificationBadge();
                    renderNotifications();
                }
            });
            
            // Admin panel tabs
            document.querySelectorAll('.filter-option[data-admin-tab]').forEach(option => {
                option.addEventListener('click', function() {
                    document.querySelectorAll('.filter-option[data-admin-tab]').forEach(opt => {
                        opt.classList.remove('active');
                    });
                    this.classList.add('active');
                    renderAdminPanel();
                });
            });
            
            // Password change form
            passwordChangeForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const currentPassword = document.getElementById('currentPassword').value;
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                
                if (newPassword !== confirmPassword) {
                    alert('New passwords do not match.');
                    return;
                }
                
                if (checkPasswordStrength(newPassword) < 3) {
                    alert('Password is too weak. Please use a stronger password.');
                    return;
                }
                
                // In a real application, you would send this to the server
                alert('Password changed successfully!');
                passwordChangeForm.reset();
                passwordStrengthBar.style.width = '0%';
            });
            
            // Password strength indicator
            document.getElementById('newPassword').addEventListener('input', function() {
                updatePasswordStrength(this.value);
            });
            
            // Biometric controls
            document.getElementById('fingerprintCheckin').addEventListener('click', function() {
                alert('Fingerprint scanner activated. Please place your finger on the scanner.');
            });
            
            document.getElementById('faceCheckin').addEventListener('click', function() {
                alert('Face recognition camera activated. Please look at the camera.');
            });
            
            document.getElementById('manualCheckin').addEventListener('click', function() {
                const employeeId = prompt('Enter Employee ID:');
                if (employeeId) {
                    const now = new Date();
                    const timeString = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    
                    // Find employee
                    const employee = assignments.find(a => a.guardId === employeeId);
                    if (employee) {
                        attendanceLog.unshift({
                            id: attendanceLog.length + 1,
                            name: employee.guardName,
                            time: timeString,
                            type: 'check-in'
                        });
                        
                        employee.checkInTime = timeString;
                        employee.status = 'active';
                        
                        renderAttendanceLog();
                        alert(`Check-in recorded for ${employee.guardName} at ${timeString}`);
                    } else {
                        alert('Employee not found. Please check the ID and try again.');
                    }
                }
            });
            
            document.getElementById('checkoutBtn').addEventListener('click', function() {
                const employeeId = prompt('Enter Employee ID:');
                if (employeeId) {
                    const now = new Date();
                    const timeString = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    
                    // Find employee
                    const employee = assignments.find(a => a.guardId === employeeId);
                    if (employee) {
                        attendanceLog.unshift({
                            id: attendanceLog.length + 1,
                            name: employee.guardName,
                            time: timeString,
                            type: 'check-out'
                        });
                        
                        employee.checkInTime = null;
                        employee.status = 'off';
                        
                        renderAttendanceLog();
                        alert(`Check-out recorded for ${employee.guardName} at ${timeString}`);
                    } else {
                        alert('Employee not found. Please check the ID and try again.');
                    }
                }
            });
            
            // Emergency chart controls
            refreshChartBtn.addEventListener('click', function() {
                alert(`Emergency chart refreshed for ${chartPeriod.value}`);
            });
            
            // Close panel buttons
            document.querySelectorAll('.close-panel').forEach(btn => {
                btn.addEventListener('click', function() {
                    this.closest('.panel').classList.remove('show');
                });
            });
            
            // NEW: Event listeners for enhanced features
            // Notification form event listeners
            notificationTitle.addEventListener('input', updateNotificationPreview);
            notificationMessage.addEventListener('input', updateNotificationPreview);
            notificationPriority.addEventListener('change', updateNotificationPreview);
            
            sendNotificationBtn.addEventListener('click', sendNotification);
            clearNotificationBtn.addEventListener('click', clearNotificationForm);
            
            // Emergency tab event listeners
            chartTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    chartTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    renderEmergencyIncidents();
                });
            });
            
            refreshEmergencyBtn.addEventListener('click', renderEmergencyIncidents);
            
            // Time adjustment event listeners
            saveShiftTimesBtn.addEventListener('click', saveShiftTimes);
            
            // Attendance tracking event listeners
            attendanceDate.addEventListener('change', renderAttendanceTable);
            attendanceEmployee.addEventListener('change', renderAttendanceTable);
            attendanceStatus.addEventListener('change', renderAttendanceTable);
            attendanceShift.addEventListener('change', renderAttendanceTable);
            exportAttendanceBtn.addEventListener('click', exportAttendanceData);
            refreshAttendanceBtn.addEventListener('click', renderAttendanceTable);
            
            // Admin communication event listeners
            sendAdminMessageBtn.addEventListener('click', sendAdminMessage);
            adminMessageInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    sendAdminMessage();
                }
            });
            
            // NEW: Profile settings event listeners
            uploadPictureBtn.addEventListener('click', uploadProfilePicture);
            profilePictureUpload.addEventListener('change', handleProfilePictureSelect);
            takePictureBtn.addEventListener('click', takePicture);
            changeEmployeePhotoBtn.addEventListener('click', uploadProfilePicture);
            
            toneOptions.forEach(option => {
                option.addEventListener('click', function() {
                    const tone = this.getAttribute('data-tone');
                    changeNotificationTone(tone);
                });
            });
            
            notificationVolume.addEventListener('input', updateNotificationVolume);
            testToneBtn.addEventListener('click', testNotificationTone);
            saveProfileSettingsBtn.addEventListener('click', saveProfileSettings);
            cancelProfileChangesBtn.addEventListener('click', function() {
                loadProfileSettings(); // Reset to saved settings
            });
            
            // NEW: Shift swap event listeners
            shiftSwapForm.addEventListener('submit', submitShiftSwapRequest);
            cancelSwapBtn.addEventListener('click', function() {
                shiftSwapForm.reset();
                
                // Set default swap date to tomorrow
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                swapDate.value = tomorrow.toISOString().split('T')[0];
            });
            
            // Initialize the application
            init();
        });
        
        // Initialize
        function init() {
            setCurrentDate();
            updateNotificationBadge();
            setupNavigationScroller();
            setupQuickAccessPanel();
            setupManagerEmergencyCommunication();
            setupBiometricLogin();
            updateNotificationPreview();
            
            // Set default next rotation date to one week from today
            const nextRotationDate = new Date();
            nextRotationDate.setDate(nextRotationDate.getDate() + 7);
            document.getElementById('nextRotation').value = nextRotationDate.toISOString().split('T')[0];
            
            // Populate employee filter
            const uniqueEmployees = [...new Set(comprehensiveAttendance.map(record => record.employeeId))];
            uniqueEmployees.forEach(employeeId => {
                const employee = comprehensiveAttendance.find(record => record.employeeId === employeeId);
                if (employee) {
                    const option = document.createElement('option');
                    option.value = employeeId;
                    option.textContent = `${employee.employeeName} (${employeeId})`;
                    attendanceEmployee.appendChild(option);
                }
            });
            
            console.log('FORS Security Management System initialized with enhanced features');
        }
    </script>
</body>
</html>
