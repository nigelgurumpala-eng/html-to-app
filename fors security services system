        // Send emergency message (manager to admin)
        function sendEmergencyMessage() {
            const messageText = document.getElementById('emergencyMessageInput').value.trim();
            if (messageText === '') return;
            
            const now = new Date();
            const timeString = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            const newMessage = {
                id: messages.length + 1,
                sender: currentUser.name,
                message: messageText,
                time: timeString,
                type: 'sent',
                priority: 'urgent'
            };
            
            messages.push(newMessage);
            renderManagerEmergencyMessages();
            
            // Clear input
            document.getElementById('emergencyMessageInput').value = '';
            
            // Add notification for admin
            notifications.unshift({
                id: notifications.length + 1,
                title: "Emergency Message",
                message: `${currentUser.name} sent an emergency message: ${messageText}`,
                time: timeString,
                unread: true,
                priority: 'urgent'
            });
            
            updateNotificationBadge();
            
            // Show success message
            alert('Emergency message sent to admin!');
        }
        
