        // Update duty status
        function updateDutyStatus() {
            // Clear current lists
            onDutyList.innerHTML = '';
            offDutyList.innerHTML = '';
            upcomingList.innerHTML = '';
            
            // Counters
            let onDuty = 0;
            let offDuty = 0;
            let upcoming = 0;
            
            // Get today's date
            const today = new Date().toISOString().split('T')[0];
            
            assignments.forEach(assignment => {
                if (assignment.date === today) {
                    if (assignment.status === 'active' && assignment.checkInTime) {
                        onDuty++;
                        const statusItem = document.createElement('div');
                        statusItem.className = 'status-item';
                        statusItem.innerHTML = `
                            <div class="status-item-avatar">${assignment.guardName.split(' ').map(n => n[0]).join('')}</div>
                            <div class="status-item-details">
                                <div class="status-item-name">${assignment.guardName}</div>
                                <div class="status-item-time">Checked in at ${assignment.checkInTime}</div>
                            </div>
                        `;
                        onDutyList.appendChild(statusItem);
                    } else if (assignment.status === 'off') {
                        offDuty++;
                        const statusItem = document.createElement('div');
                        statusItem.className = 'status-item';
                        statusItem.innerHTML = `
                            <div class="status-item-avatar">${assignment.guardName.split(' ').map(n => n[0]).join('')}</div>
                            <div class="status-item-details">
                                <div class="status-item-name">${assignment.guardName}</div>
                                <div class="status-item-time">Day off</div>
                            </div>
                        `;
                        offDutyList.appendChild(statusItem);
                    } else {
                        upcoming++;
                        const statusItem = document.createElement('div');
                        statusItem.className = 'status-item';
                        
                        let shiftTime = '';
                        switch(assignment.shift) {
                            case 'morning': shiftTime = '06:00 - 14:00'; break;
                            case 'afternoon': shiftTime = '14:00 - 22:00'; break;
                            case 'night': shiftTime = '22:00 - 06:00'; break;
                        }
                        
                        statusItem.innerHTML = `
                            <div class="status-item-avatar">${assignment.guardName.split(' ').map(n => n[0]).join('')}</div>
                            <div class="status-item-details">
                                <div class="status-item-name">${assignment.guardName}</div>
                                <div class="status-item-time">${shiftTime}</div>
                            </div>
                        `;
                        upcomingList.appendChild(statusItem);
                    }
                }
            });
            
            // Update counts
            onDutyCount.textContent = onDuty;
            offDutyCount.textContent = offDuty;
            upcomingCount.textContent = upcoming;
        }
        
