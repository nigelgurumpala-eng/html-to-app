                filteredAssignments = assignments.filter(assignment => assignment.location === filter);
            }
            
            if (filteredAssignments.length === 0) {
                assignmentsGrid.innerHTML = '<p style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-light);">No assignments found.</p>';
                return;
            }
            
            filteredAssignments.forEach((assignment, index) => {
                const card = document.createElement('div');
                card.className = 'assignment-card';
                card.style.animationDelay = `${index * 0.1}s`;
                
                let shiftText = '';
                switch(assignment.shift) {
                    case 'morning': shiftText = 'Morning (06:00 - 14:00)'; break;
                    case 'afternoon': shiftText = 'Afternoon (14:00 - 22:00)'; break;
                    case 'night': shiftText = 'Night (22:00 - 06:00)'; break;
                }
                
                let locationText = '';
                switch(assignment.location) {
                    case 'main-gate': locationText = 'Main Gate'; break;
                    case 'north-wing': locationText = 'North Wing'; break;
                    case 'south-wing': locationText = 'South Wing'; break;
                    case 'control-room': locationText = 'Control Room'; break;
                    case 'patrol': locationText = 'Patrol Duty'; break;
                }
                
                card.innerHTML = `
                    <div class="card-header">
                        <div class="location">${locationText}</div>
                        <div class="shift-time">${shiftText}</div>
                    </div>
                    <div class="card-body">
                        <div class="guard-info">
                            <div class="guard-photo">
                                ${assignment.photo ? `<img src="${assignment.photo}" alt="${assignment.guardName}">` : `<i class="fas fa-user"></i>`}
                            </div>
                            <div class="guard-details">
                                <h3>${assignment.guardName}</h3>
                                <p>ID: ${assignment.guardId}</p>
                            </div>
                        </div>
                        <div class="assignment-details">
                            <div class="detail-item">
                                <div class="detail-label">Date:</div>
                                <div>${new Date(assignment.date).toLocaleDateString()}</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Status:</div>
                                <div><span class="status status-${assignment.status}">${assignment.status.charAt(0).toUpperCase() + assignment.status.slice(1)}</span></div>
                            </div>
